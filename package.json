{
  "name": "chatbot-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:widget",
    "build:widget": "node ./scripts/build-widget.mjs",
    "dev:worker": "wrangler dev worker/index.js",
    "deploy:worker": "wrangler deploy",
    "deploy:worker:preview": "wrangler deploy --env preview",
    "deploy:worker:production": "wrangler deploy",
    "preview:demo": "python3 -m http.server 4173",
    "test:worker": "node ./scripts/test-worker.mjs",
    "test:guardrails": "node ./scripts/test-guardrails.mjs",
    "context:check": "node ./scripts/context-maintenance-check.mjs",
    "logs:tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.10.0"
  }
}
